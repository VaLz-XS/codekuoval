{
  "redirects": [
    { "source": "/ah.html", "destination": "/unknown", "permanent": false }
  ],
  "rewrites": [
    { "source": "/unknown", "destination": "/ah.html" },
    { "source": "/p/:id", "destination": "/view.html" },
    { "source": "/raw/:id", "destination": "/api/raw?id=:id" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/unknown",
      "headers": [ { "key": "X-Robots-Tag", "value": "noindex, nofollow" } ]
    }
  ]
}
